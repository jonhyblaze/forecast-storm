else
  BOLD="" DIM="" ITALIC="" RESET=""
  BLACK="" RED="" GREEN="" YELLOW="" BLUE="" MAGENTA="" CYAN="" WHITE=""
  BG_BLACK="" BG_BLUE="" BG_CYAN="" BG_WHITE="" BG_DARK="" BG_CARD=""
  FG_GRAY="" FG_LGRAY="" FG_DGRAY="" FG_ORANGE="" FG_GOLD="" FG_SKY=""
  FG_TEAL="" FG_CYAN="" FG_PINK="" FG_LBLUE="" FG_LGREEN="" FG_CREAM=""
fi

# ─── api keys (env or config file) ────────────────────────────
CONFIG_FILE="${HOME}/.config/forecast-storm/config"
_load_config() {
  if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
  fi
}
_load_config

VISUAL_CROSSING_KEY="${VISUAL_CROSSING_KEY:-}"
WEATHERAPI_KEY="${WEATHERAPI_KEY:-}"

# ─── constants ─────────────────────────────────────────────────
VISUAL_CROSSING_BASE="https://weather.visualcrossing.com/VisualCrossingWebServices/rest/services/timeline"
WEATHERAPI_BASE="https://api.weatherapi.com/v1"
IPGEO_BASE="https://api.ipgeolocation.io/ipgeo"
CACHE_DIR="${HOME}/.cache/forecast-storm"
CACHE_TTL=900  # 15 min

# ─── helpers ──────────────────────────────────────────────────
_die()   { echo -e "${RED}${BOLD}error:${RESET} $*" >&2; exit 1; }
_warn()  { echo -e "${YELLOW}${BOLD}warn:${RESET}  $*" >&2; }
_info()  { echo -e "${FG_GRAY}$*${RESET}"; }

_dep_check() {
  local missing=()
  for cmd in curl jq; do
    command -v "$cmd" &>/dev/null || missing+=("$cmd")
  done
  if (( ${#missing[@]} )); then
    _die "missing dependencies: ${missing[*]}\n  Install with: apt install ${missing[*]}  OR  brew install ${missing[*]}"
  fi
}

_cache_key() {
  echo "$1" | tr ' /' '__' | tr '[:upper:]' '[:lower:]'
}

_cache_get() {
  local key="$1" file
  file="$CACHE_DIR/$(_cache_key "$key").json"
  if [[ -f "$file" ]]; then
    local age=$(( $(date +%s) - $(date -r "$file" +%s 2>/dev/null || echo 0) ))
    (( age < CACHE_TTL )) && cat "$file" && return 0
  fi
  return 1
}

_cache_set() {
  local key="$1" data="$2"
  mkdir -p "$CACHE_DIR"
  echo "$data" > "$CACHE_DIR/$(_cache_key "$key").json"
}

_http_get() {
  local url="$1"
  curl -fsSL --max-time 10 \
       -H "User-Agent: forecast-storm/$VERSION" \
       "$url" 2>/dev/null
}

# ─── spinner ──────────────────────────────────────────────────
_spinner_start() {
  local msg="${1:-loading}"
  echo -ne "${FG_GRAY}  ${msg}...${RESET}"
  ( while true; do
      for s in '⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏'; do
        echo -ne "\r${FG_TEAL}${s}${RESET} ${FG_GRAY}${msg}...${RESET}"
        sleep 0.08
      done
    done ) &
  _SPINNER_PID=$!
  disown "$_SPINNER_PID" 2>/dev/null || true
}

_spinner_stop() {
  if [[ -n "${_SPINNER_PID:-}" ]]; then
    kill "$_SPINNER_PID" 2>/dev/null || true
    wait "$_SPINNER_PID" 2>/dev/null || true
    _SPINNER_PID=""
    echo -ne "\r\033[2K"
  fi
}
trap '_spinner_stop' EXIT

# ─── location ─────────────────────────────────────────────────
_get_ip_city() {
  local data
  data=$(_http_get "https://ipapi.co/json/") || return 1
  echo "$data" | jq -r '.city // empty' 2>/dev/null
}

# ─── weather API ──────────────────────────────────────────────
_fetch_weather() {
  local city="$1"
  local cache_key="vc_${city}"
  local cached
  if cached=$(_cache_get "$cache_key" 2>/dev/null); then
    echo "$cached"
    return 0
  fi

  if [[ -z "$VISUAL_CROSSING_KEY" ]]; then
    # demo mode: use open-meteo (no key needed)
    _fetch_openmeteo "$city"
    return
  fi

  local encoded_city
  encoded_city=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$city" 2>/dev/null || \
    echo "$city" | sed 's/ /%20/g')
  local url="${VISUAL_CROSSING_BASE}/${encoded_city}?unitGroup=metric&key=${VISUAL_CROSSING_KEY}&contentType=json&elements=datetime,tempmax,tempmin,temp,feelslike,humidity,precip,precipprob,windspeed,windgust,winddir,cloudcover,visibility,uvindex,pressure,conditions,description,icon,moonphase,sunrise,sunset"

  local data
  data=$(_http_get "$url") || _die "Visual Crossing API request failed"
  _cache_set "$cache_key" "$data"
  echo "$data"
}

_fetch_openmeteo() {
  # Geocode city first
  local city="$1"
  local encoded_city
  encoded_city=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$city" 2>/dev/null || \
    echo "$city" | sed 's/ /%20/g')

  local geo_url="https://geocoding-api.open-meteo.com/v1/search?name=${encoded_city}&count=1&language=en&format=json"
  local geo
  geo=$(_http_get "$geo_url") || _die "geocoding failed"

  local lat lon country city_name
  lat=$(echo "$geo" | jq -r '.results[0].latitude // empty')
  lon=$(echo "$geo" | jq -r '.results[0].longitude // empty')
  country=$(echo "$geo" | jq -r '.results[0].country // ""')
  city_name=$(echo "$geo" | jq -r '.results[0].name // empty')
  [[ -z "$lat" ]] && _die "city not found: $city"

  local wx_url="https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,relative_humidity_2m,apparent_temperature,precipitation,rain,weather_code,cloud_cover,wind_speed_10m,wind_direction_10m,wind_gusts_10m,pressure_msl,surface_pressure,uv_index&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_sum,precipitation_probability_max,wind_speed_10m_max,wind_gusts_10m_max,uv_index_max,sunrise,sunset&timezone=auto&forecast_days=5"
  local wx
  wx=$(_http_get "$wx_url") || _die "open-meteo request failed"

  # Normalize into a common shape (subset of Visual Crossing schema)
  local now
  now=$(echo "$wx" | jq -r '.current')
  local daily
  daily=$(echo "$wx" | jq '.daily')

  # Build normalized JSON
  jq -n \
    --arg city "$city_name" \
    --arg country "$country" \
    --argjson now "$now" \
    --argjson daily "$daily" \
    '{
      resolvedAddress: ($city + ", " + $country),
      days: ($daily.time | to_entries | map({
        datetime:      .value,
        tempmax:       $daily.temperature_2m_max[.key],
        tempmin:       $daily.temperature_2m_min[.key],
        temp:          (($daily.temperature_2m_max[.key] + $daily.temperature_2m_min[.key]) / 2),
        precipprob:    $daily.precipitation_probability_max[.key],
        precip:        $daily.precipitation_sum[.key],
        windspeed:     $daily.wind_speed_10m_max[.key],
        windgust:      $daily.wind_gusts_10m_max[.key],
        uvindex:       $daily.uv_index_max[.key],
        sunrise:       "sunrise",
        sunset:        "sunset",
        conditions:    "",
        icon:          "cloudy",
        moonphase:     0.5,
        cloudcover:    0,
        humidity:      0,
        visibility:    10,
        pressure:      $now.pressure_msl,
        winddir:       $now.wind_direction_10m,
        feelslike:     $now.apparent_temperature,
        description:   ""
      })),
      currentConditions: {
        temp:          $now.temperature_2m,
        feelslike:     $now.apparent_temperature,
        humidity:      $now.relative_humidity_2m,
        precip:        $now.precipitation,
        precipprob:    0,
        windspeed:     $now.wind_speed_10m,
        windgust:      $now.wind_gusts_10m,
        winddir:       $now.wind_direction_10m,
        cloudcover:    $now.cloud_cover,
        pressure:      $now.pressure_msl,
        uvindex:       ($now.uv_index // 0),
        visibility:    10,
        conditions:    "",
        icon:          "cloudy",
        sunrise:       "06:00:00",
        sunset:        "20:00:00",
        moonphase:     0.5
      }
    }'
}

_fetch_astro() {
  local city="$1"
  [[ -z "$WEATHERAPI_KEY" ]] && return 0
  local cache_key="astro_${city}"
  local cached
  if cached=$(_cache_get "$cache_key" 2>/dev/null); then echo "$cached"; return 0; fi
  local encoded_city
  encoded_city=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$city" 2>/dev/null || \
    echo "$city" | sed 's/ /%20/g')
  local url="${WEATHERAPI_BASE}/astronomy.json?key=${WEATHERAPI_KEY}&q=${encoded_city}"
  local data
  data=$(_http_get "$url") || return 0
  _cache_set "$cache_key" "$data"
  echo "$data"
}

# ─── unit converters / helpers ────────────────────────────────
_kmh_to_ms() {
  python3 -c "print(f'{float(\"$1\")*1000/3600:.1f}')" 2>/dev/null || echo "$1"
}

_compass() {
  local deg="$1"
  local dirs=(N NNE NE ENE E ESE SE SSE S SSW SW WSW W WNW NW NNW)
  local idx
  idx=$(python3 -c "print(int((float('$deg') * 16 / 360 + 1) % 16))" 2>/dev/null || echo 0)
  echo "${dirs[$idx]}"
}

_moon_icon() {
  # moonphase is 0..1 float
  local phase="$1"
  local p
  p=$(python3 -c "p=float('$phase'); print(int(p*8))" 2>/dev/null || echo 4)
  local icons=('🌑' '🌒' '🌓' '🌔' '🌕' '🌖' '🌗' '🌘' '🌑')
  echo "${icons[$p]:-🌕}"
}

_moon_name() {
  local phase="$1"
  python3 -c "
p=float('$phase')
if p<0.02 or p>0.98: print('New Moon')
elif p<0.24: print('Waxing Crescent')
elif p<0.26: print('First Quarter')
elif p<0.48: print('Waxing Gibbous')
elif p<0.52: print('Full Moon')
elif p<0.74: print('Waning Gibbous')
elif p<0.76: print('Last Quarter')
else: print('Waning Crescent')
" 2>/dev/null || echo "—"
}

_weather_icon() {
  local icon="$1" cond="$2"
  case "$icon" in
    clear-day)           echo "☀️"  ;;
    clear-night)         echo "🌙"  ;;
    partly-cloudy-day)   echo "⛅"  ;;
    partly-cloudy-night) echo "🌤"  ;;
    cloudy)              echo "☁️"  ;;
    rain)                echo "🌧"  ;;
    showers-day)         echo "🌦"  ;;
    snow)                echo "❄️"  ;;
    sleet)               echo "🌨"  ;;
    wind)                echo "💨"  ;;
    fog)                 echo "🌫"  ;;
    thunder-rain)        echo "⛈"  ;;
    thunder-showers-day) echo "🌩"  ;;
    *)                   echo "🌡"  ;;
  esac
}

_uv_level() {
  local uv="$1"
  python3 -c "
u=float('$uv')
if u<3:   print('Low')
elif u<6: print('Moderate')
elif u<8: print('High')
elif u<11:print('Very High')
else:     print('Extreme')
" 2>/dev/null || echo "—"
}

_uv_color() {
  local uv="$1"
  python3 -c "
u=float('$uv')
if u<3:   print('\\033[38;5;120m')
elif u<6: print('\\033[38;5;220m')
elif u<8: print('\\033[38;5;214m')
elif u<11:print('\\033[38;5;196m')
