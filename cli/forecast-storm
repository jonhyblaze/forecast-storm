_wind_rose() {
  local deg="$1"
  python3 -c "
d = float('$deg') % 360
idx = int((d + 22.5) / 45) % 8
arrow = ['↑', '↗', '→', '↘', '↓', '↙', '←', '↖'][idx]
print('   N   ')
print('NW   NE')
print(f'W  {arrow}  E')
print('SW   SE')
print('   S   ')
" 2>/dev/null
}

_fmt_date() {
  local d="$1"
  python3 -c "
from datetime import datetime
try:
    dt = datetime.strptime('$d','%Y-%m-%d')
    print(dt.strftime('%a %b %-d'))
except: print('$d')
" 2>/dev/null || echo "$d"
}

_today_label() {
  python3 -c "from datetime import datetime; print(datetime.now().strftime('%A, %B %-d %Y'))" 2>/dev/null || date '+%A, %B %d %Y'
}

_round() {
  python3 -c "print(round(float('$1')))" 2>/dev/null || echo "$1"
}

# ─── box drawing helpers ───────────────────────────────────────
# bash ${#} counts codepoints, not columns: emoji like 🌧 (1 codepoint) render
# as 2 columns, while ☁️ (base + U+FE0F variation selector) is also 2 columns
# but counts as 2 codepoints — causing per-row misalignment. Use Python instead.
_display_width() {
  echo -n "$1" | python3 -c "
import unicodedata, sys
s = sys.stdin.read()
w = 0
for c in s:
    o = ord(c)
    if 0xFE00 <= o <= 0xFE0F or 0xE0100 <= o <= 0xE01EF:
        continue
    if unicodedata.category(c) in ('Mn', 'Cf', 'Cc'):
        continue
    eaw = unicodedata.east_asian_width(c)
    if eaw in ('W', 'F'):
        w += 2
    elif eaw == 'A' and 0x2600 <= o <= 0x27BF:
        w += 2
    else:
        w += 1
print(w)
" 2>/dev/null || echo "${#1}"
}

_box_top()    { local w="$1"; printf "┌"; printf '─%.0s' $(seq 1 $((w-2))); printf "┐\n"; }
_box_bot()    { local w="$1"; printf "└"; printf '─%.0s' $(seq 1 $((w-2))); printf "┘\n"; }
_box_sep()    { local w="$1"; printf "├"; printf '─%.0s' $(seq 1 $((w-2))); printf "┤\n"; }
_box_mid()    { local w="$1" content="$2"
  local vis vlen pad
  vis=$(echo -e "$content" | sed 's/\x1b\[[0-9;]*m//g')
  vlen=$(_display_width "$vis")
  pad=$(( w - 3 - vlen ))
  (( pad < 0 )) && pad=0
  printf "│ "; echo -ne "$content"; printf "%*s│\n" "$pad" ""; }
_box_empty()  { local w="$1"; printf "│%*s│\n" $((w-2)) ""; }

_hbar() {
  # _hbar VALUE MAX WIDTH COLOR
  local val="$1" max="$2" width="$3" color="${4:-$GREEN}"
  local filled
  filled=$(python3 -c "v=float('$val');m=float('$max');w=int('$width'); print(min(int(v/m*w),w))" 2>/dev/null || echo 0)
  local empty=$(( width - filled ))
  printf "${color}"
  printf '█%.0s' $(seq 1 $filled) 2>/dev/null
  printf "${FG_DGRAY}"
  printf '░%.0s' $(seq 1 $empty) 2>/dev/null
  printf "${RESET}"
}

