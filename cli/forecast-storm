# ─── section: TODAY ───────────────────────────────────────────
_render_today() {
  local data="$1"
  local city
  city=$(echo "$data" | jq -r '.resolvedAddress // "Unknown"')
  local today
  today=$(echo "$data" | jq -r '.currentConditions // .days[0]')
  local temp feelslike tmax tmin hum icon cond desc
  temp=$(echo "$today"     | jq -r '.temp // 0')
  feelslike=$(echo "$today"| jq -r '.feelslike // 0')
  hum=$(echo "$today"      | jq -r '.humidity // 0')
  icon=$(echo "$today"     | jq -r '.icon // "cloudy"')
  cond=$(echo "$today"     | jq -r '.conditions // ""')
  tmax=$(echo "$data"      | jq -r '.days[0].tempmax // 0')
  tmin=$(echo "$data"      | jq -r '.days[0].tempmin // 0')
  desc=$(echo "$data"      | jq -r '.days[0].description // ""')

  local wi
  wi=$(_weather_icon "$icon" "$cond")
  local temp_r feelslike_r tmax_r tmin_r hum_r
  temp_r=$(_round "$temp")
  feelslike_r=$(_round "$feelslike")
  tmax_r=$(_round "$tmax")
  tmin_r=$(_round "$tmin")
  hum_r=$(_round "$hum")

  local W=52
  _box_top $W
  _box_mid $W "${BOLD}${FG_CREAM} $wi  $city${RESET}"
  _box_mid $W "${FG_DGRAY} $(_today_label)${RESET}"
  _box_sep $W
  _box_mid $W "🌡️ ${FG_SKY}${BOLD}  $(printf '%3d' "$temp_r")°C${RESET}  ${FG_GRAY}feels like ${feelslike_r}°C${RESET}"
  _box_mid $W "${FG_LGRAY}  ↑ ${tmax_r}°C  ↓ ${tmin_r}°C   💧 ${hum_r}%${RESET}"
  if [[ -n "$cond" ]]; then
    _box_mid $W "${FG_GRAY}  ${cond}${RESET}"
  fi
  if [[ -n "$desc" ]]; then
    # word-wrap desc to width-6 chars
    local maxw=$(( W - 6 ))
    while IFS= read -r line; do
      _box_mid $W "${FG_DGRAY}  ${line}${RESET}"
    done < <(echo "$desc" | fold -s -w "$maxw")
  fi
  _box_bot $W
  echo ""
}

# ─── section: FORECAST ────────────────────────────────────────
_render_forecast() {
  local data="$1"
  local W=52
  echo -e "${BOLD}${FG_LGRAY}  4-Day Forecast${RESET}"
  echo ""
  _box_top $W
  _box_mid $W "${FG_DGRAY}  Day            High    Low    Precip${RESET}"
  _box_sep $W
  local i
  for i in 1 2 3 4; do
    local day
    day=$(echo "$data" | jq -r ".days[$i] // empty")
    [[ -z "$day" ]] && continue
    local dt tmax tmin pp icon wi
    dt=$(echo "$day" | jq -r '.datetime')
    tmax=$(echo "$day" | jq -r '.tempmax // 0')
    tmin=$(echo "$day" | jq -r '.tempmin // 0')
    pp=$(echo "$day"   | jq -r '.precipprob // 0')
    icon=$(echo "$day" | jq -r '.icon // "cloudy"')
    wi=$(_weather_icon "$icon" "")
    dt=$(_fmt_date "$dt")
    local tmax_r tmin_r pp_r
    tmax_r=$(_round "$tmax")
    tmin_r=$(_round "$tmin")
    pp_r=$(_round "$pp")
    local bar
    bar=$(_hbar "$pp_r" "100" "8" "$FG_SKY")
    _box_mid $W "  ${wi} ${FG_CREAM} $(printf '%-10s' "$dt")${RESET} ${FG_ORANGE}$(printf '%3d' "$tmax_r")°${RESET} ${FG_LBLUE}$(printf '%3d' "$tmin_r")°${RESET}  ${bar}${FG_DGRAY}${pp_r}%${RESET}"
  done
  _box_bot $W
  echo ""
}

# ─── section: WIND ────────────────────────────────────────────
_render_wind() {
  local data="$1"
  local today
  today=$(echo "$data" | jq -r '.currentConditions // .days[0]')
  local spd gust dir
  spd=$(echo "$today"  | jq -r '.windspeed // 0')
  gust=$(echo "$today" | jq -r '.windgust // 0')
  dir=$(echo "$today"  | jq -r '.winddir // 0')

  local spd_ms gust_ms compass
  spd_ms=$(_kmh_to_ms "$spd")
  gust_ms=$(_kmh_to_ms "$gust")
  compass=$(_compass "$dir")

  local rose
  rose=$(_wind_rose "$dir")

  local W=52
  echo -e "${BOLD}${FG_LGRAY}  Wind${RESET}"
  echo ""
  _box_top $W

  local spd_r gust_r
  spd_r=$(_round "$spd")
  gust_r=$(_round "$gust")

  # Draw wind rose side-by-side with stats
  local rose_lines=()
  while IFS= read -r line; do
    rose_lines+=("$line")
  done <<< "$rose"

  local stats=(
    "${FG_CREAM}${BOLD} Speed${RESET}   ${FG_TEAL}${spd_ms} m/s${RESET} ${FG_DGRAY}(${spd_r} km/h)${RESET}"
    "${FG_CREAM}${BOLD} Gusts${RESET}   ${FG_ORANGE}${gust_ms} m/s${RESET} ${FG_DGRAY}(${gust_r} km/h)${RESET}"
    "${FG_CREAM}${BOLD} Dir${RESET}     ${FG_GOLD}${compass}${RESET} ${FG_DGRAY}(${dir}°)${RESET}"
    ""
    "${FG_DGRAY} Rose (N=up)${RESET}"
  )

  # pad rose_lines to 5
  while (( ${#rose_lines[@]} < 5 )); do rose_lines+=("     "); done

  _box_mid $W "${stats[0]}"
  _box_mid $W "${stats[1]}"
  _box_mid $W "${stats[2]}"
  _box_sep $W
  _box_mid $W "${FG_DGRAY} Compass${RESET}"
  for l in "${rose_lines[@]}"; do
    _box_mid $W "   ${FG_TEAL}${l}${RESET}"
  done
  _box_bot $W
  echo ""
}

# ─── section: CONDITIONS ──────────────────────────────────────
_render_conditions() {
  local data="$1"
  local today
  today=$(echo "$data" | jq -r '.currentConditions // .days[0]')
  local day0
  day0=$(echo "$data" | jq -r '.days[0]')

  local pp precip cloud hum vis
  pp=$(echo "$today"     | jq -r '.precipprob // (env.day0 | fromjson.precipprob) // 0' 2>/dev/null || \
       echo "$day0"      | jq -r '.precipprob // 0')
  precip=$(echo "$today" | jq -r '.precip // 0')
  cloud=$(echo "$today"  | jq -r '.cloudcover // 0')
  hum=$(echo "$today"    | jq -r '.humidity // 0')
  vis=$(echo "$today"    | jq -r '.visibility // 0')

  local pp_r precip_r cloud_r hum_r vis_r
  pp_r=$(_round "$pp")
  precip_r=$(python3 -c "print(f'{float(\"$precip\"):.1f}')" 2>/dev/null || echo "$precip")
  cloud_r=$(_round "$cloud")
  hum_r=$(_round "$hum")
  vis_r=$(_round "$vis")

  local W=52
  echo -e "${BOLD}${FG_LGRAY}  Conditions${RESET}"
  echo ""
  _box_top $W
  local max_vis=20
  _box_mid $W " 🌂 Precip prob   ${FG_SKY}${pp_r}%${RESET}   $(_hbar "$pp_r" "100" "12" "$FG_SKY")"
  _box_mid $W " 💧 Precip        ${FG_LBLUE}${precip_r} mm${RESET}"
  _box_mid $W " ☁️  Cloud cover   ${FG_GRAY}${cloud_r}%${RESET}    $(_hbar "$cloud_r" "100" "12" "$FG_GRAY")"
  _box_mid $W " 💦 Humidity      ${FG_CYAN}${hum_r}%${RESET}    $(_hbar "$hum_r" "100" "12" "$FG_CYAN")"
  _box_mid $W " 👁  Visibility   ${FG_LGRAY}${vis_r} km${RESET}   $(_hbar "$vis_r" "$max_vis" "12" "$FG_LGRAY")"
  _box_bot $W
  echo ""
}

# ─── section: AIR ─────────────────────────────────────────────
_render_air() {
  local data="$1"
  local today
  today=$(echo "$data" | jq -r '.currentConditions // .days[0]')

  local uv press
  uv=$(echo "$today"    | jq -r '.uvindex // 0')
  press=$(echo "$today" | jq -r '.pressure // 1013')

  local uv_r press_r
  uv_r=$(_round "$uv")
  press_r=$(_round "$press")

  local uv_lv press_lv uv_color
  uv_lv=$(_uv_level "$uv_r")
  press_lv=$(_pressure_level "$press_r")
  uv_color=$(_uv_color "$uv_r")

  local W=52
  echo -e "${BOLD}${FG_LGRAY}  Air Quality & Atmosphere${RESET}"
  echo ""
  _box_top $W
  _box_mid $W " ☀️  UV Index      ${uv_color}${BOLD}${uv_r}${RESET}  ${FG_DGRAY}(${uv_lv})${RESET}  $(_hbar "$uv_r" "12" "12" "$uv_color")"
  _box_mid $W " 🌡  Pressure     ${FG_PINK}${press_r} hPa${RESET}  ${FG_DGRAY}(${press_lv})${RESET}"
  _box_bot $W
  echo ""
}

# ─── section: SUN ─────────────────────────────────────────────
_render_sun() {
  local data="$1"
  local today
  today=$(echo "$data" | jq -r '.currentConditions // .days[0]')

  local rise set
  rise=$(echo "$today" | jq -r '.sunrise // "06:00:00"')
  set=$(echo "$today"  | jq -r '.sunset // "20:00:00"')
  rise=$(echo "$rise" | cut -c1-5)
  set=$(echo "$set"   | cut -c1-5)

  local W=52
  local icon_sunrise="\ue34c"
  local icon_sunset="\ue34d"

  echo -e "${BOLD}${FG_LGRAY}  Sun${RESET}"
  echo ""
  _box_top $W
  _box_mid $W "  ${icon_sunrise} Sunrise   ${FG_GOLD}${rise}${RESET}"
  _box_mid $W "  ${icon_sunset} Sunset    ${FG_ORANGE}${set}${RESET}"
  _box_bot $W
  echo ""
}

# ─── section: MOON ────────────────────────────────────────────
_render_moon() {
  local data="$1" astro="${2:-}"
  local today
  today=$(echo "$data" | jq -r '.currentConditions // .days[0]')
  local moonphase
  moonphase=$(echo "$data" | jq -r '.days[0].moonphase // .currentConditions.moonphase // 0.5')

  local mi mn moonrise moonset illum
  mi=$(_moon_icon "$moonphase")
  mn=$(_moon_name "$moonphase")

  if [[ -n "$astro" ]]; then
    moonrise=$(echo "$astro" | jq -r '.astronomy.astro.moonrise // "—"' 2>/dev/null || echo "—")
    moonset=$(echo "$astro"  | jq -r '.astronomy.astro.moonset // "—"' 2>/dev/null || echo "—")
    illum=$(echo "$astro"    | jq -r '.astronomy.astro.moon_illumination // "—"' 2>/dev/null || echo "—")
  else
    moonrise="—"
    moonset="—"
    illum=$(python3 -c "
import math
p=float('$moonphase')
phase_angle = abs(p - 0.5) * 2
illum = (1 - math.cos(math.pi * (1-phase_angle))) / 2 * 100
print(f'{illum:.0f}')
" 2>/dev/null || echo "—")
  fi

  local W=52
  echo -e "${BOLD}${FG_LGRAY}  Moon${RESET}"
  echo ""
  _box_top $W
  _box_mid $W "  ${mi}  ${FG_CREAM}${mn}${RESET}"
  _box_mid $W "  ${FG_DGRAY}Illumination${RESET}  ${FG_GOLD}${illum}%${RESET}"
  [[ "$moonrise" != "—" ]] && _box_mid $W "  🌕 Moonrise    ${FG_LGRAY}${moonrise}${RESET}"
  [[ "$moonset"  != "—" ]] && _box_mid $W "  🌑 Moonset     ${FG_DGRAY}${moonset}${RESET}"
  _box_bot $W
  echo ""
}

# ─── plain-text output (for curl/wget pipe) ───────────────────
_render_plain() {
  local data="$1" city="$2"
  local resolved
  resolved=$(echo "$data" | jq -r '.resolvedAddress // "'"$city"'"')
  local today
  today=$(echo "$data" | jq -r '.currentConditions // .days[0]')

  local temp tmax tmin feel hum pp wind gust dir cond icon
  temp=$(_round "$(echo "$today" | jq -r '.temp // 0')")
  tmax=$(_round "$(echo "$data"  | jq -r '.days[0].tempmax // 0')")
  tmin=$(_round "$(echo "$data"  | jq -r '.days[0].tempmin // 0')")
  feel=$(_round "$(echo "$today" | jq -r '.feelslike // 0')")
  hum=$(_round  "$(echo "$today" | jq -r '.humidity // 0')")
  pp=$(_round "$(echo "$data" | jq -r '(.currentConditions.precipprob // .days[0].precipprob // 0)')")
  wind=$(echo "$today"  | jq -r '.windspeed // 0')
  gust=$(echo "$today"  | jq -r '.windgust // 0')
  dir=$(_compass "$(echo "$today" | jq -r '.winddir // 0')")
  cond=$(echo "$today"  | jq -r '.conditions // ""')
  icon=$(echo "$today"  | jq -r '.icon // "cloudy"')
  local wi
  wi=$(_weather_icon "$icon" "$cond")

  cat <<EOF

 forecast-storm / $resolved
 $(_today_label)
 ─────────────────────────────────────
 ${wi}  ${temp}°C  (feels ${feel}°C)   ↑${tmax}° ↓${tmin}°
 ${cond}
 ─────────────────────────────────────
 Humidity      ${hum}%
 Precip prob   ${pp}%
 Wind          $(_kmh_to_ms "$wind") m/s ${dir}
 Gusts         $(_kmh_to_ms "$gust") m/s
 ─────────────────────────────────────
 4-day:
EOF

  for i in 1 2 3 4; do
    local day
    day=$(echo "$data" | jq -r ".days[$i] // empty")
    [[ -z "$day" ]] && continue
    local dt dx tn tx p ic
    dt=$(_fmt_date "$(echo "$day" | jq -r '.datetime')")
    tn=$(_round "$(echo "$day" | jq -r '.tempmin // 0')")
    tx=$(_round "$(echo "$day" | jq -r '.tempmax // 0')")
    p=$(_round  "$(echo "$day" | jq -r '.precipprob // 0')")
    ic=$(echo "$day" | jq -r '.icon // "cloudy"')
    dx=$(_weather_icon "$ic" "")
    printf "   %-10s  %s  ↑%3d° ↓%3d°  💧%3d%%\n" "$dt" "$dx" "$tx" "$tn" "$p"
  done
  echo ""
}

# ─── full TUI render ──────────────────────────────────────────
_render_tui() {
  local data="$1" astro="$2"
  clear
  _banner
  _render_today "$data"
  _render_forecast "$data"

  # Two columns: left=wind, right=sun+moon stacked
  _render_wind "$data"
  _render_sun "$data"
  _render_moon "$data" "$astro"
  _render_conditions "$data"
  _render_air "$data"

  echo -e "${FG_DGRAY}  Data: Visual Crossing / Open-Meteo / WeatherAPI  •  Forecast CLI v${VERSION}${RESET}"
  echo ""
}

# ─── interactive mode (live refresh with keypress) ────────────
_interactive() {
  local city="$1"
  local last_city="$city"
  while true; do
    _spinner_start "fetching $last_city"
    local data astro
    data=$(_fetch_weather "$last_city") || { _spinner_stop; _die "fetch failed"; }
    astro=$(_fetch_astro "$last_city" 2>/dev/null || echo "")
    _spinner_stop
    _render_tui "$data" "$astro"
    echo -e "${FG_DGRAY}  [r] refresh  [c] change city  [q] quit  [h] help${RESET}"
    echo -n "  > "
    local key
    IFS= read -r -n1 key
    echo ""
    case "$key" in
      r|R) _cache_del "$last_city" ;;
      c|C)
        echo -n "  city: "
        IFS= read -r last_city
        ;;
      q|Q|$'\004') echo ""; exit 0 ;;
      h|H) _show_help; sleep 3 ;;
    esac
  done
}

_cache_del() {
  local city="$1"
  rm -f "$CACHE_DIR/$(_cache_key "vc_${city}").json" \
         "$CACHE_DIR/$(_cache_key "astro_${city}").json" 2>/dev/null || true
}

# ─── setup wizard ─────────────────────────────────────────────
_setup() {
  echo -e ""
  echo -e "${FG_SKY}${BOLD}  forecast-storm setup${RESET}"
  echo -e "${FG_DGRAY}  Configure API keys for full features.${RESET}"
  echo -e "${FG_DGRAY}  Press ENTER to skip any key.${RESET}"
  echo ""

  local vc wa
  echo -n "  Visual Crossing API key: "
  read -r vc
  echo -n "  WeatherAPI key (moon data): "
  read -r wa

  mkdir -p "$(dirname "$CONFIG_FILE")"
  cat > "$CONFIG_FILE" <<EOF
# forecast-storm configuration
# Generated: $(date)
VISUAL_CROSSING_KEY="${vc:-}"
WEATHERAPI_KEY="${wa:-}"
EOF
  chmod 600 "$CONFIG_FILE"
  echo ""
  echo -e "${GREEN}  ✓ Config saved to ${CONFIG_FILE}${RESET}"
  echo ""
}

# ─── install self ─────────────────────────────────────────────
_install() {
  local dest="${1:-/usr/local/bin/forecast-storm}"
  local self
  self="$(realpath "${BASH_SOURCE[0]}")"
  if [[ "$self" != "$dest" ]]; then
    cp "$self" "$dest"
    chmod +x "$dest"
    echo -e "${GREEN}  ✓ Installed to $dest${RESET}"
    echo -e "${FG_DGRAY}  Run: forecast-storm [city]${RESET}"
  else
    echo -e "${FG_GRAY}  Already installed at $dest${RESET}"
  fi
}

# ─── help ─────────────────────────────────────────────────────
_show_help() {
  cat <<'EOF'

  forecast-storm — terminal weather TUI

  USAGE
    forecast-storm [OPTIONS] [CITY]
    curl -fsSL https://forecast-storm.vercel.app/api/cli | bash -s -- [CITY]

  OPTIONS
    -h, --help          Show this help
    -v, --version       Print version
    -p, --plain         Plain text output (no TUI, no colors) — great for pipes
    -j, --json          Raw JSON output from the weather API
    -r, --refresh       Force refresh (bypass cache)
        --setup         Configure API keys
        --install [PATH] Install to PATH (default: /usr/local/bin)
        --clear-cache   Clear all cached data

  EXAMPLES
    forecast-storm                     # Auto-detect city from IP
    forecast-storm "New York"          # Specific city
    forecast-storm -p London           # Plain text, pipe-friendly
    forecast-storm -j Tokyo | jq .     # Raw JSON
    forecast-storm --refresh Berlin    # Skip cache

  CURL ONE-LINER
    curl -fsSL https://forecast-storm.vercel.app/api/cli | bash -s -- London

  ENVIRONMENT
    VISUAL_CROSSING_KEY   Visual Crossing API key
    WEATHERAPI_KEY        WeatherAPI.com key (moon data)

  CONFIG
    ~/.config/forecast-storm/config    (set by --setup)

  WITHOUT API KEYS
    Falls back to Open-Meteo (free, no key needed).
    Set keys for full data: moon phases, AQI, detailed astronomy.

EOF
}

# ─── one-shot plain output (for curl pipe UX) ─────────────────
_run_once_plain() {
  local city="$1" force_refresh="$2"
  [[ "$force_refresh" == "1" ]] && _cache_del "$city"
  _spinner_start "fetching $city"
  local data
  data=$(_fetch_weather "$city") || { _spinner_stop; _die "fetch failed"; }
  _spinner_stop
  _render_plain "$data" "$city"
}

_run_once_tui() {
  local city="$1" force_refresh="$2"
  [[ "$force_refresh" == "1" ]] && _cache_del "$city"
  _spinner_start "fetching $city"
  local data astro
  data=$(_fetch_weather "$city") || { _spinner_stop; _die "fetch failed"; }
  astro=$(_fetch_astro "$city" 2>/dev/null || echo "")
  _spinner_stop
  _render_tui "$data" "$astro"
}

# ─── main entry point ─────────────────────────────────────────
main() {
  _dep_check

  local city="" mode="tui" force_refresh="0" json_mode="0"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)          _show_help; exit 0 ;;
      -v|--version)       echo "forecast-storm $VERSION"; exit 0 ;;
      -p|--plain)         mode="plain" ;;
      -j|--json)          json_mode="1" ;;
      -r|--refresh)       force_refresh="1" ;;
      -i|--interactive)   mode="interactive" ;;
      --setup)            _setup; exit 0 ;;
      --install)          _install "${2:-}"; exit 0 ;;
      --clear-cache)      rm -rf "$CACHE_DIR"; echo "Cache cleared."; exit 0 ;;
      --)                 shift; city="$*"; break ;;
      -*)                 _die "unknown option: $1  (try --help)" ;;
      *)                  city="${city:+$city }$1" ;;
    esac
    shift
  done

  # Auto-detect city if not provided
  if [[ -z "$city" ]]; then
    _spinner_start "detecting location"
    city=$(_get_ip_city 2>/dev/null || echo "Berlin")
    _spinner_stop
    [[ -z "$city" ]] && city="Berlin"
  fi

  [[ "$force_refresh" == "1" ]] && _cache_del "$city"

  if [[ "$json_mode" == "1" ]]; then
    _spinner_start "fetching $city"
    local data
    data=$(_fetch_weather "$city")
    _spinner_stop
    echo "$data" | jq .
    exit 0
  fi

  case "$mode" in
    plain)       _run_once_plain "$city" "$force_refresh" ;;
    interactive) _interactive "$city" ;;
    tui)
      # Detect if running inside a pipe or non-interactive terminal
      if [ ! -t 1 ]; then
        _run_once_plain "$city" "$force_refresh"
      else
        _run_once_tui "$city" "$force_refresh"
      fi
      ;;
  esac
}

main "$@"
